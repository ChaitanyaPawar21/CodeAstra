# ---- Server -----------------------------------------------------------------
# The Vite dev proxy reads this value, so frontend and backend stay in sync.
# (If PORT is omitted the backend listens on 3000.)
PORT=5000
NODE_ENV=development

# ---- Database ---------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/codeastra

# ---- Existing CodeAstra services -------------------------------------------
GITHUB_TOKEN=
NVIDIA_API_KEY=

# ---- Authentication ----------------------------------------------------------
# REQUIRED. Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Optional. Token / cookie lifetime (e.g. 15m, 12h, 7d). Default: 7d
JWT_EXPIRES_IN=7d

# URL of the browser app. Used for CORS and for the redirect after Google login.
# Local dev (Vite): http://localhost:5173   |  Production: https://your-domain
FRONTEND_URL=http://localhost:5173

# ---- Google OAuth 2.0 (optional - leave blank to disable "Continue with Google")
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client ID -> Web application) and add GOOGLE_CALLBACK_URL as an
# "Authorized redirect URI". It must match EXACTLY.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dev:  http://localhost:5000/api/auth/google/callback
# Prod: https://your-domain/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
